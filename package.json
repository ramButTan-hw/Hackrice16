{
  "name": "hackrice16",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "node --watch server/index.js",
    "dev:electron": "wait-on http://127.0.0.1:5173 http://127.0.0.1:3001/api/health && electron . --dev",
    "build": "vite build",
    "start": "npm run build && electron .",
    "server": "node server/index.js",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.3.0",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  }
}
