DATA_PROVIDER=sqlite
DATABASE_PATH=data/companion.sqlite
# Cloud mode: run the migration, set DATA_PROVIDER=supabase, then fill these locally.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Gemini chat (server only; never use a VITE_ prefix)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Retry once on temporary overload/connection failure before any reply text arrives.
GEMINI_FALLBACK_MODEL=gemini-3-flash-preview
# Separate low-thinking model for short automatic check-in decisions.
GEMINI_CHECKIN_MODEL=gemini-3.6-flash
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Optional Python override. Default: data/wake-env/Scripts/python.exe on Windows.
# Install locally using scripts/setup-wake.py with Python 3.12.
WAKE_PYTHON=

# Optional voice replies (server only)
ELEVENLABS_API_KEY=
# Speech input uses Scribe v2; no voice ID is needed for transcription.
# Backboard stores task context in separate real/demo assistants created on first use.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_v3

# Desktop continuous monitoring (main process only)
PRESAGE_API_KEY=
BACKBOARD_API_KEY=
